# Copia este archivo a .env en la raíz del proyecto y completa los valores.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

AUTH_MODE=microsoft
# Mínimo 16 caracteres; no uses valores de ejemplo.
JWT_SECRET=genera-una-clave-larga-propia-aqui

# App pública de Microsoft (solo identidad: correo). Sin permisos a Graph/archivos.
MS_CLIENT_ID=d3590ed6-52b3-4102-aeff-aad2292ab01c
MS_AUTHORITY=https://login.microsoftonline.com/common
MS_SCOPE=openid profile email

# En producción agrega el dominio real del frontend, separado por comas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# true solo si necesitas /docs en un entorno controlado
EXPOSE_DOCS=false
