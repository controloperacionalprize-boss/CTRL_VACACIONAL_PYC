# Copia este archivo a .env en la raíz del proyecto y completa los valores.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

AUTH_MODE=microsoft
# Mínimo 16 caracteres; no uses valores de ejemplo.
JWT_SECRET=genera-una-clave-larga-propia-aqui

# App pública de Microsoft (solo identidad: correo). Sin permisos a Graph/archivos.
MS_CLIENT_ID=d3590ed6-52b3-4102-aeff-aad2292ab01c
MS_AUTHORITY=https://login.microsoftonline.com/common
MS_SCOPE=openid profile email

# En producción agrega el dominio real del frontend, separado por comas (sin barra final).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ctrl-vacacional-pyc.vercel.app,https://ctrl-vacacional-pyc-controloperacionalprize-boss-projects.vercel.app
# Previews de Vercel (ctrl-vacacional-<hash>-<equipo>.vercel.app).
CORS_ORIGIN_REGEX=https://ctrl-vacacional[\w.-]*\.vercel.app$

# true solo si necesitas /docs en un entorno controlado
EXPOSE_DOCS=false

# --- Marcación / asistencia ---
ATTENDANCE_DATABASE_URL=postgresql://USUARIO:PASSWORD@db-control-operacional.XXXX.us-east-2.rds.amazonaws.com:5432/NOMBRE_BD?sslmode=require
ATTENDANCE_SCHEMA=public
ATTENDANCE_TABLE=rpt_asistencia_hik
ATTENDANCE_DNI_COLUMN=ID
ATTENDANCE_DATE_COLUMN=Fecha
ATTENDANCE_TIME_COLUMN=Tiempo

# Excel SharePoint HIK (script: python scripts/obtener_token_excel_sharepoint.py)
ATTENDANCE_EXCEL_SHARE_URL=https://aquanqape.sharepoint.com/:x:/s/OficinasPrizePeru/IQASVoFGz1YGRrZ3y1evRGebAYPOBVtwO-n7iVbrwsbjhow?e=62Iffv
ATTENDANCE_EXCEL_REFRESH_TOKEN=

# Fotos del personal (repo CCozd/PICTURES). Match por usuario del correo (roster JSON).
PICTURES_ENABLED=true
PICTURES_REPO=CCozd/PICTURES
PICTURES_BASE_URL=https://raw.githubusercontent.com/CCozd/PICTURES/main
